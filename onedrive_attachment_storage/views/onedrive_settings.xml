<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- OneDrive Attachments Action (Define first, referenced later) -->
    <record id="action_onedrive_attachments" model="ir.actions.act_window">
        <field name="name">OneDrive Attachments</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_onedrive', '=', True)]</field>
        <field name="context">{'search_default_is_onedrive': 1}</field>
    </record>
    
    <!-- OneDrive Configuration Form View -->
    <record id="view_onedrive_config_form" model="ir.ui.view">
        <field name="name">onedrive.config.form</field>
        <field name="model">onedrive.config</field>
        <field name="arch" type="xml">
            <form string="OneDrive Storage Configuration">
                <header>
                    <button name="action_test_connection" 
                            string="Test Connection" 
                            type="object" 
                            class="oe_highlight"
                            invisible="not active"/>
                    <button name="action_sync_attachments" 
                            string="Sync Existing Attachments" 
                            type="object" 
                            class="oe_highlight"
                            confirm="This will upload all existing binary attachments to OneDrive. This process may take some time. Continue?"
                            invisible="not active"/>
                    <field name="connection_status" widget="statusbar" 
                           statusbar_visible="not_tested,connected,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_onedrive_attachments)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-cloud">
                            <field name="total_files" widget="statinfo" 
                                   string="Files in OneDrive"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Disabled" 
                            bg_color="bg-danger" 
                            invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="company_id" class="oe_edit_only"/>
                        <h1>
                            <field name="company_id" 
                                   options="{'no_create': True, 'no_open': True}"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="General Settings">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="last_sync_date" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Authentication" name="authentication">
                            <group>
                                <group string="Azure AD Configuration">
                                    <field name="tenant_id" 
                                           placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                           required="1"/>
                                    <field name="client_id" 
                                           placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                           required="1"/>
                                    <field name="client_secret" 
                                           password="True"
                                           required="1"/>
                                    <field name="drive_id" 
                                           placeholder="Optional - Leave empty for default drive"/>
                                </group>
                                <group string="Token Information" groups="base.group_system">
                                    <field name="token_expiry" readonly="1"/>
                                    <field name="access_token" readonly="1" password="True"/>
                                </group>
                            </group>
                            
                            <group>
                                <field name="connection_message" 
                                       readonly="1" 
                                       invisible="not connection_message"/>
                            </group>
                            
                            <div class="alert alert-info" role="alert">
                                <strong>Setup Instructions:</strong>
                                <ol>
                                    <li>Register an application in Azure AD</li>
                                    <li>Grant permissions: Files.ReadWrite.All, Sites.ReadWrite.All</li>
                                    <li>Create a client secret</li>
                                    <li>Copy Tenant ID, Client ID, and Client Secret here</li>
                                    <li>Click "Test Connection" to verify</li>
                                </ol>
                            </div>
                        </page>
                        
                        <page string="Folder Structure" name="folders">
                            <group>
                                <group string="OneDrive Folder Configuration">
                                    <field name="root_folder" 
                                           placeholder="/Odoo/Attachments"
                                           required="1"/>
                                    <field name="use_company_folders"/>
                                    <field name="use_model_folders"/>
                                    <field name="use_record_folders"/>
                                </group>
                            </group>
                            
                            <div class="alert alert-info" role="alert">
                                <strong>Folder Structure Preview:</strong>
                                <pre>
<field name="root_folder" invisible="1"/>
Example path with all options enabled:
/Odoo/Attachments/[Company]/[Model]/[RecordID]/filename.pdf

Example:
/Odoo/Attachments/My Company/sale.order/42/quotation.pdf
                                </pre>
                            </div>
                        </page>
                        
                        <page string="Statistics" name="statistics">
                            <group>
                                <group string="Storage Statistics">
                                    <field name="total_files" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- OneDrive Configuration Tree View -->
    <record id="view_onedrive_config_tree" model="ir.ui.view">
        <field name="name">onedrive.config.tree</field>
        <field name="model">onedrive.config</field>
        <field name="arch" type="xml">
            <tree string="OneDrive Configurations">
                <field name="company_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="connection_status" decoration-success="connection_status=='connected'" 
                       decoration-danger="connection_status=='error'"/>
                <field name="total_files"/>
                <field name="last_sync_date"/>
            </tree>
        </field>
    </record>
    
    <!-- OneDrive Configuration Search View -->
    <record id="view_onedrive_config_search" model="ir.ui.view">
        <field name="name">onedrive.config.search</field>
        <field name="model">onedrive.config</field>
        <field name="arch" type="xml">
            <search string="OneDrive Configurations">
                <field name="company_id"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active','=',False)]"/>
                <filter string="Connected" name="connected" 
                        domain="[('connection_status','=','connected')]"/>
                <filter string="Error" name="error" 
                        domain="[('connection_status','=','error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="company" 
                            context="{'group_by':'company_id'}"/>
                    <filter string="Status" name="status" 
                            context="{'group_by':'connection_status'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- OneDrive Configuration Action -->
    <record id="action_onedrive_config" model="ir.actions.act_window">
        <field name="name">OneDrive Storage</field>
        <field name="res_model">onedrive.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure OneDrive Storage
            </p>
            <p>
                Set up Microsoft OneDrive integration to store all Odoo attachments in the cloud.
            </p>
        </field>
    </record>
    
    <!-- Menu Items -->
    <menuitem id="menu_onedrive_root"
              name="OneDrive Storage"
              parent="base.menu_administration"
              sequence="100"/>
    
    <menuitem id="menu_onedrive_config"
              name="Configuration"
              parent="menu_onedrive_root"
              action="action_onedrive_config"
              sequence="10"/>
    
    <menuitem id="menu_onedrive_attachments"
              name="OneDrive Files"
              parent="menu_onedrive_root"
              action="action_onedrive_attachments"
              sequence="20"/>

</odoo>
