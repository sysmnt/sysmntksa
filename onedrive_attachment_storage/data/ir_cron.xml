<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Cron Job: Migrate Attachments to OneDrive -->
        <record id="ir_cron_onedrive_migration" model="ir.cron">
            <field name="name">OneDrive: Migrate Attachments (Background)</field>
            <field name="model_id" ref="model_onedrive_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_migrate_attachments_batch()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">1</field>
            <field name="active" eval="False"/>
            <field name="doall" eval="False"/>
            <field name="priority">10</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
        
        <!-- Cron Job: Refresh OneDrive Token -->
        <record id="ir_cron_onedrive_token_refresh" model="ir.cron">
            <field name="name">OneDrive: Refresh Access Token</field>
            <field name="model_id" ref="model_onedrive_config"/>
            <field name="state">code</field>
            <field name="code">
# Refresh tokens for all active configurations
configs = model.search([('active', '=', True)])
for config in configs:
    try:
        client = env['onedrive.client'].create_client(config)
    except Exception as e:
        _logger.error(f"Failed to refresh token for {config.company_id.name}: {str(e)}")
            </field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">5</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
        
        <!-- Cron Job: Cleanup Failed Uploads -->
        <record id="ir_cron_onedrive_cleanup" model="ir.cron">
            <field name="name">OneDrive: Cleanup Failed Uploads</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="state">code</field>
            <field name="code">
# Find attachments with OneDrive fields but no valid URL
failed_attachments = model.search([
    ('onedrive_file_id', '!=', False),
    '|',
    ('url', '=', False),
    ('url', '=', '')
])

# Log and optionally retry or clean up
for attachment in failed_attachments:
    _logger.warning(f"Found orphaned OneDrive attachment: {attachment.name} (ID: {attachment.id})")
    # Could implement retry logic here
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
            <field name="doall" eval="False"/>
            <field name="priority">15</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
        
    </data>
</odoo>
